<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sosyal Halısaha | Video Downloader</title>
    <link rel="icon" href="/assets/football.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --pitch-900: #0b3b1d;
        --pitch-700: #146c38;
        --pitch-600: #1a8045;
        --pitch-500: #22a857;
        --pitch-400: #4dd07a;
        --pitch-50: #ecfbf0;
        --ink-900: #0d100e;
        --ink-700: #2a2f2c;
        --ink-500: #5b635e;
        --ink-400: #828a84;
        --ink-300: #b6bcb7;
        --line: #e2e6e2;
        --line-soft: #eef0ed;
        --surface: #ffffff;
        --bg: #f4f5f1;
        --radius-lg: 20px;
        --radius-md: 12px;
        --radius-sm: 8px;
        --shadow-card: 0 1px 0 rgba(15, 30, 20, 0.04), 0 20px 40px -24px rgba(15, 30, 20, 0.18);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Geist', system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        background: var(--bg);
        color: var(--ink-900);
      }

      .stage {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 24px;
        position: relative;
        overflow: hidden;
      }

      .stage::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 50% 50%, rgba(34, 168, 87, 0.06), transparent 60%),
          repeating-linear-gradient(90deg, transparent 0 80px, rgba(20, 108, 56, 0.035) 80px 81px);
        pointer-events: none;
      }

      .stage::after {
        content: '';
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 320px;
        height: 320px;
        border-radius: 50%;
        border: 1px solid rgba(20, 108, 56, 0.08);
        pointer-events: none;
      }

      .card {
        position: relative;
        z-index: 1;
        background: var(--surface);
        border-radius: var(--radius-lg);
        border: 1px solid var(--line);
        box-shadow: var(--shadow-card);
        max-width: 480px;
        width: 100%;
        overflow: hidden;
        animation: card-in 0.25s ease both;
      }

      @keyframes card-in {
        from {
          opacity: 0;
          transform: translateY(4px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Brand header */
      .brand-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 18px 22px;
        border-bottom: 1px solid var(--line-soft);
      }

      .brand-logo {
        width: 28px;
        height: 28px;
        flex-shrink: 0;
        background-color: var(--pitch-700);
        -webkit-mask: url('/assets/football.svg') no-repeat center;
        mask: url('/assets/football.svg') no-repeat center;
        -webkit-mask-size: contain;
        mask-size: contain;
      }

      .brand-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .brand-name {
        font-size: 14px;
        font-weight: 600;
        color: var(--ink-900);
        letter-spacing: -0.01em;
        line-height: 1;
      }

      .brand-sub {
        font-size: 11px;
        font-weight: 500;
        color: var(--ink-400);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      /* Card body */
      .card-body {
        padding: 28px 28px 24px;
      }

      .eyebrow {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-400);
        margin-bottom: 6px;
      }

      .card-title {
        font-size: 22px;
        font-weight: 600;
        color: var(--ink-900);
        letter-spacing: -0.02em;
        text-wrap: pretty;
        margin-bottom: 6px;
      }

      .card-sub {
        font-size: 14px;
        color: var(--ink-500);
        margin-bottom: 24px;
        line-height: 1.5;
      }

      .field-label {
        display: block;
        font-size: 12px;
        font-weight: 500;
        color: var(--ink-700);
        margin-bottom: 6px;
      }

      .input-wrap {
        position: relative;
        margin-bottom: 16px;
      }

      .input-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--ink-400);
        pointer-events: none;
        display: flex;
        align-items: center;
      }

      .url-input {
        width: 100%;
        height: 46px;
        padding: 0 42px 0 40px;
        font-family: 'Geist Mono', 'Menlo', 'Consolas', monospace;
        font-size: 13px;
        color: var(--ink-900);
        background: #fbfcfa;
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        outline: none;
        transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
      }

      .url-input::placeholder {
        color: var(--ink-400);
      }

      .url-input:focus {
        background: #fff;
        border-color: var(--pitch-500);
        box-shadow: 0 0 0 4px rgba(34, 168, 87, 0.12);
      }

      .clear-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        padding: 2px;
        cursor: pointer;
        color: var(--ink-300);
        display: none;
        align-items: center;
        border-radius: 4px;
        transition: color 0.1s;
      }

      .clear-btn:hover {
        color: var(--ink-500);
      }

      .clear-btn.visible {
        display: flex;
      }

      .clear-btn:focus-visible {
        outline: 2px solid var(--pitch-500);
        outline-offset: 2px;
      }

      .submit-btn {
        width: 100%;
        height: 48px;
        background: var(--pitch-700);
        color: #fff;
        font-family: 'Geist', system-ui, sans-serif;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: -0.005em;
        border: none;
        border-radius: var(--radius-md);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.18), 0 1px 2px rgba(11, 59, 29, 0.18);
        transition: background 0.15s ease, transform 0.05s ease;
        margin-bottom: 16px;
      }

      .submit-btn:hover {
        background: var(--pitch-600);
      }

      .submit-btn:active {
        transform: translateY(1px);
      }

      .submit-btn:focus-visible {
        outline: 2px solid var(--pitch-500);
        outline-offset: 2px;
      }

      .submit-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
        transform: none;
      }

      .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        flex-shrink: 0;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      .submit-btn.loading .btn-label {
        opacity: 0.5;
      }

      .disclaimer {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: #fafbf8;
        border: 1px solid var(--line-soft);
        border-radius: var(--radius-md);
        padding: 12px 14px;
        font-size: 12px;
        color: var(--ink-500);
        line-height: 1.55;
      }

      .disclaimer-icon {
        flex-shrink: 0;
        margin-top: 1px;
        color: var(--ink-400);
      }
    </style>
  </head>
  <body>
    <div class="stage">
      <div class="card">
        <header class="brand-header">
          <span class="brand-logo" aria-hidden="true"></span>

          <div class="brand-text">
            <span class="brand-name">Sosyal Halısaha</span>
            <span class="brand-sub">Video Downloader</span>
          </div>

        </header>

        <div class="card-body">
          <p class="eyebrow">Step 1</p>
          <h1 class="card-title">Paste your video link</h1>
          <p class="card-sub">Enter a Sosyal Halısaha video URL to download your match recording.</p>

          <form action="/download" method="POST" id="download-form">
            <label class="field-label" for="videoUrl">Video URL</label>
            <div class="input-wrap">
              <span class="input-icon">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M6.5 9.5a3.5 3.5 0 0 0 5 0l2-2a3.5 3.5 0 0 0-4.95-4.95L7.3 3.8"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M9.5 6.5a3.5 3.5 0 0 0-5 0l-2 2a3.5 3.5 0 0 0 4.95 4.95l1.25-1.25"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <input
                type="url"
                name="videoUrl"
                id="videoUrl"
                class="url-input"
                placeholder="https://sosyalhalisaha.com/video-detay/..."
                required
                autocomplete="off"
                spellcheck="false"
              />
              <button type="button" class="clear-btn" id="clearBtn" aria-label="Clear">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </button>
            </div>

            <button type="submit" class="submit-btn" id="submitBtn">
              <span class="btn-label">Download Video →</span>
            </button>
          </form>

          <div class="disclaimer">
            <span class="disclaimer-icon">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <circle cx="7" cy="7" r="5.75" stroke="currentColor" stroke-width="1.3" />
                <line x1="7" y1="6.5" x2="7" y2="10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                <circle cx="7" cy="4.5" r="0.65" fill="currentColor" />
              </svg>
            </span>
            <span
              >This tool is for personal and educational use only. Downloading videos is subject to the terms of use of
              the respective website. Please respect the rights of content owners.</span
            >
          </div>
        </div>
      </div>
    </div>

    <script>
      const input = document.getElementById('videoUrl');
      const clearBtn = document.getElementById('clearBtn');
      const form = document.getElementById('download-form');
      const submitBtn = document.getElementById('submitBtn');

      input.addEventListener('input', () => {
        clearBtn.classList.toggle('visible', input.value.length > 0);
      });

      clearBtn.addEventListener('click', () => {
        input.value = '';
        clearBtn.classList.remove('visible');
        input.focus();
      });

      form.addEventListener('submit', () => {
        submitBtn.disabled = true;
        submitBtn.classList.add('loading');
        submitBtn.innerHTML = '<div class="spinner"></div><span class="btn-label">Scraping…</span>';
      });
    </script>
  </body>
</html>
